rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only allow these two specific Firebase UIDs for sensitive data
    function isAuthorized() {
      return request.auth != null && (
        request.auth.uid == '3FIf4jUvTuYen4obvEyYlp5BFmt2' || 
        request.auth.uid == 'yuAocDq0IlTRWbbyZNLxgi0LiHx1'
      );
    }

    match /users/{userId} {
      // Allow the login screen to look up any ID to find the associated email
      allow get: if true;
      
      // Everything else (updating profile, listing users) requires authorization
      allow list, write: if isAuthorized();
    }

    // Protect all other data and SUBCOLLECTIONS (chats, tasks, avatars, etc.)
    // ONLY the two authorized accounts can see or modify this data.
    match /{allPaths=**} {
      allow read, write: if isAuthorized();
    }
  }
}
