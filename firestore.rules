rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 256
        && data.fullName is string && data.fullName.size() <= 128
        && data.role is string && (data.role == 'employer' || data.role == 'helper')
        && data.primaryLanguage is string && data.primaryLanguage.size() <= 64
        && data.dietaryRestrictions is list
        && data.firebaseUid is string && data.firebaseUid.size() <= 128
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
        && isValidId(userId)
        && isValidUser(incoming())
        && (request.auth.uid == existing().firebaseUid || request.auth.uid == userId)
        && incoming().createdAt == existing().createdAt
        && incoming().email == existing().email
        && incoming().firebaseUid == existing().firebaseUid;
      allow delete: if false;

      match /profile_data/{docId} {
        allow read, write: if isSignedIn() && isValidId(userId);
      }
    }

    match /connections/{connectionId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
